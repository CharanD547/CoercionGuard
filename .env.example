# Optional: lets an LLM drive the agent instead of the built-in heuristic.
AGENT_MODE=heuristic
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=llama-3.1-70b-instruct-fp8

MAX_CONCURRENT_CONTEXTS=4
STEP_DELAY_MS=600
RATE_LIMIT_PER_MINUTE=20
CORS_ORIGINS=*

# Live page reviews
REVIEW_TTL_SECONDS=3600
CAPTURE_TIMEOUT_SECONDS=35

# Reminder approval: a long random token for the demo operator, the team calendar ID,
# and a service account (inline JSON or a file path) that the calendar is shared with.
OPERATOR_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
