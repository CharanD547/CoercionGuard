---
import Lab from "../components/Lab.astro";
import SandboxComparison from "../components/SandboxComparison.astro";
import PageReview from "../components/PageReview.astro";
import "../styles/lab.css";
---
<!doctype html>
<html lang="en" class="intro">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#101814">
<title>CoercionGuard consent lab</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet">

</head>
<body>
<noscript>
  <style is:inline>html.intro body { overflow: auto } html.intro .intro-ui { display: none } html.intro #exhibit { position: absolute; z-index: auto } html.intro .lab-ui { opacity: 1; visibility: visible }</style>
  <p>Enable JavaScript to check proposals and run the sandbox comparison.</p>
</noscript>

<header class="bar lab-ui">
  <a class="wordmark" href="./">CoercionGuard</a>
  <nav class="product-nav" aria-label="Main navigation">
    <a href="#page-review">Live review</a>
    <a href="#lab">Consent lab</a>
    <a href="#developers">For developers</a>
  </nav>
  <button class="ghost" id="replay" hidden>Replay intro</button>
</header>

<PageReview />
<Lab />
<SandboxComparison />
<section class="lab-ui developer-panel" id="developers" aria-labelledby="developers-title">
  <h2 id="developers-title">Guard an agent action</h2>
  <p>Send the user’s authorized limits and the proposed action before your tool runs. The API returns an allow, block, or review decision with reasons.</p>
  <a href="/docs#/Action%20guard">API reference</a>
  <a href="#lab">Try block → revise → allow</a>
  <details>
    <summary>Example API request</summary>
    <pre tabindex="0"><code>POST /api/v1/guard/check
Content-Type: application/json

{JSON.stringify({
  policy: {currency:"USD",max_immediate_charge_minor:4000,allowed_recurring_intervals:[],allowed_data_fields:[]},
  proposal: {currency:"USD",immediate_charge_minor:4900,recurring_interval:"none",data_fields:[]},
}, null, 2)}</code></pre>
  </details>
</section>
<footer class="lab-ui">CoercionGuard</footer>

<script>import "../scripts/lab.js";</script>
</body>
</html>
